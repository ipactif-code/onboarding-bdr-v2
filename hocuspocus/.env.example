# Hocuspocus Server Configuration
# Copy this file to .env and fill in your values

# Server port (default: 1234)
PORT=1234

# Clerk Secret Key for JWT verification
# Get this from https://dashboard.clerk.com/
CLERK_SECRET_KEY=sk_live_xxxxx

# Node environment
NODE_ENV=development

# Docker Compose Configuration
# Set HOCUSPOCUS_PORT to change the host port mapping (default: 1234)
HOCUSPOCUS_PORT=1234
# Health check port (default: 1235)
HOCUSPOCUS_HEALTH_PORT=1235
