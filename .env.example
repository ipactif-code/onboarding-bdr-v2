# =============================================================================
# Onboarding BDR Team v2 LMS - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values

# =============================================================================
# CONVEX
# =============================================================================
# Get these from: https://dashboard.convex.dev
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
CONVEX_DEPLOY_KEY=prod:your-deploy-key

# =============================================================================
# CLERK AUTHENTICATION
# =============================================================================
# Get these from: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# New redirect props (replaces deprecated afterSignInUrl/afterSignUpUrl)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# =============================================================================
# OPTIONAL: AI FEATURES (for Plate.js AI features)
# =============================================================================
# OPENAI_API_KEY=sk-...

# =============================================================================
# HOCUSPOCUS REAL-TIME COLLABORATION
# =============================================================================
HOCUSPOCUS_URL=ws://localhost:4444/yjs
HOCUSPOCUS_SECRET=
HOCUSPOCUS_PORT=4444
HOCUSPOCUS_HOST=0.0.0.0
HOCUSPOCUS_PATH=/yjs
